<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- 1. AREA BACKGROUND / WALLPAPER (Tengah) -->
    <ImageView
        android:id="@+id/imgWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:color/darker_gray" />

    <!-- 2. STATUS BAR SEDERHANA (Pojok Kanan Atas: Jam) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:background="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:32"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. SIDEBAR MENU (Panel Sebelah Kiri) -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_margin="20dp"
        android:background="#CC121212"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="My TV Launcher"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Tombol Menu 1: Home (Fokus Utama) -->
        <Button
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#333333"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="🏠  Home"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFF" />

        <!-- Tombol Menu 2: YouTube -->
        <Button
            android:id="@+id/btnYoutube"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#222222"
            android:focusable="true"
            android:text="▶  YouTube"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFF" />

        <!-- Tombol Menu 3: Netflix -->
        <Button
            android:id="@+id/btnNetflix"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#222222"
            android:focusable="true"
            android:text="N  Netflix"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- 4. BOTTOM BAR (Panel Bagian Bawah) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="#CC121212"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#222222"
            android:focusable="true"
            android:text="⚙ Settings"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#222222"
            android:focusable="true"
            android:text="📱 Apps"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#222222"
            android:focusable="true"
            android:text="🌙 Sleep"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
          
